{
  "name": "boersenparty",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @boersenparty/api\" \"npm run dev -w @boersenparty/web\"",
    "db:migrate": "npm run db:migrate -w @boersenparty/api",
    "db:seed": "npm run db:seed -w @boersenparty/api",
    "import:wristbands": "npm run import:wristbands -w @boersenparty/api",
    "proxy:up": "docker compose up -d lan-proxy",
    "proxy:down": "docker compose down",
    "proxy:logs": "docker compose logs -f lan-proxy"
  },
  "devDependencies": {"concurrently": "^9.1.2"},
  "engines": {"node": ">=22"}
}
