+    ['FREE_DRINK_REDEMPTION', `SELECT 1 FROM free_drink_entitlements f JOIN orders o ON o.id=f.redeemed_order_id WHERE o.wallet_id<>f.wallet_id OR o.total_cents<>0 LIMIT 1`],
